# Service Configuration
SERVICE_NAME=encounter-service
PORT=8000
DEBUG=True

# MongoDB Configuration
MONGO_URI=mongodb://admin:password@mongodb:27017
MONGO_DB_NAME=transcript_db

# Kafka Configuration
