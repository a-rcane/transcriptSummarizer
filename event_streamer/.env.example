# Streamer Service Configuration
SERVICE_NAME=event-streamer
PORT=8001
DEBUG=True

# Target Encounter Service Webhook Endpoint
ENCOUNTER_SERVICE_WEBHOOK_URL=http://encounter-service:8000/webhook

# Kafka Configuration (for direct topic streaming)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ENCOUNTER_TOPIC=encounter-events

# Stream Simulator Defaults
DEFAULT_STREAM_INTERVAL_MS=500
DEFAULT_DUPLICATE_RATE=0.15
DEFAULT_OUT_OF_ORDER_RATE=0.20
